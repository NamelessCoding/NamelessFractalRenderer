<Window x:Class="RealTimeFractalRendererGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RealTimeFractalRendererGUI"
        xmlns:opentk="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        xmlns:uitk="clr-namespace:Xceed.Wpf.Toolkit;assembly=DotNetProjects.Wpf.Extended.Toolkit"
        mc:Ignorable="d"
        Title="RealTimeFractalRenderer GUI"
        Height="1080" Width="1920" WindowState="Maximized"
        DataContext="{Binding RelativeSource={x:Static RelativeSource.Self}}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <opentk:GLWpfControl Grid.Column="0"
            x:Name="display" 
            SizeChanged="Display_SizeChanged"
            Ready="Display_Ready"
            Render="Display_OnRender"
            MouseWheel="Display_MouseWheel"
            MouseMove="Display_MouseMove"
            MouseDown="Display_MouseDown"
            Focusable="True"/>

        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Grid>
                    <Label>Framerate</Label>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Run Text="{Binding FrameCounter, Mode=OneWay}"/> FPS
                    </TextBlock>
                </Grid>
                <Label>Brightness</Label>
                <uitk:SingleUpDown Value="{Binding Renderer.SceneBrightness}" FormatString="N6"
                               Minimum="0" Maximum="1000" Increment="0.1" />
                <Label>Camera Yaw</Label>
                <uitk:SingleUpDown Value="{Binding CameraYaw}" FormatString="N3"
                               Increment="1"/>
                <Label Content="Sun Direction"/>
                <StackPanel Orientation="Horizontal">
                    <Label>X</Label>
                    <Slider Height="22" Width="116" Value="{Binding XL}" Minimum="-1" Maximum="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label>Y</Label>
                    <Slider Height="22" Width="116" Value="{Binding YL}" Minimum="0.01" Maximum="1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label>Z</Label>
                    <Slider Height="22" Width="116" Value="{Binding ZL}" Minimum="-1" Maximum="1"/>
                </StackPanel>
                <CheckBox IsChecked="{Binding Renderer.EnableFinalBlur}">Enable blur</CheckBox>
                <Label>Cloud Coverage</Label>
                <uitk:SingleUpDown Value="{Binding CloudCoverage}" FormatString="N3"
                Minimum="0" Maximum="1.0" Increment="0.01" />
            </StackPanel>
            <StackPanel Grid.Row="1">
                <Separator/>
                <Grid>
                    <Label>Debug Texture</Label>
                    <Button Click="ClearDebugTexButton_Click" HorizontalAlignment="Right">Clear</Button>
                </Grid>
                <ComboBox ItemsSource="{Binding Textures}"
                      SelectedValue="{Binding Renderer.DebugTextureOverride, Mode=TwoWay}" 
                      DisplayMemberPath="Name" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
